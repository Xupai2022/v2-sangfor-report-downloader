# .env.ppt 的模板。复制成 .env.ppt 并填 OPENAI_API_KEY。
#
#     cp .env.ppt.example .env.ppt
#
# 谁能读这个文件：vendor/mss_ai_ppt_sample_assets/backend/config.py。
# 它先读进程 env MSS_ENV_PATH（默认指向仓库根的 .env.ppt），再
# load_dotenv(override=True)。
#
# override=True 的后果 —— 这是本文件最重要的一条约定：
#
#     这个文件里出现的键会**盖掉**进程 env。
#
# 所以要按两类分：
#   - 密钥与功能开关 → 写本文件（它们是事实，不该被命令行改写）
#   - 路径与可调参数 → **不写本文件**，只由 pipeline.js 注入进程 env
#     （超时、输出目录这类要能按次覆盖；写进来就覆盖不动，而且不报错）
#
# 校验生效：node pipeline.js doctor --json 会报 env.exists / enable_llm / llm.reachable。

# 打开 LLM。设为 false 时 AI 位会退化成 mock 文案
# （形如「[token: AI generated content]」），看起来像成功 —— 所以 doctor 会报警。
ENABLE_LLM=true

# 留空且 ENABLE_LLM=true 时，config.py 的 Settings() 在 import 期直接抛
# ValueError("OPENAI_API_KEY is required when ENABLE_LLM is enabled")。
# 那是响亮的失败，不是静默降级。但更省事的做法是留空的同时把 ENABLE_LLM 设为 false。
OPENAI_API_KEY=

OPENAI_BASE_URL=https://api.ai-native-x.site/v1

# 模型名：2026-09-24 换成 api-native-x 网关后由用户指定。
# 旧网关（newapi-ai.sangfor.com）的可用集合是 glm-5.1 / glm-5.3-flash / deepseek-v4-pro /
# deepseek-v4-flash / qwen3-32b-local / text-model-gold —— 已作废，只当历史记录。
# 四种失败长得完全不一样，别混为一谈：
#   401 → key 本身不对（换 key）
#   403 → 该 key 没有这个模型（换名字）
#   503 → 网关有这个模型名但没有可用通道（换名字）
#   10061 / ConnectError → 地址压根连不通（先确认是不是在集群里跑）
# 查本 key 能用哪些：
#   python -m pptgen doctor --list-models
# 换完重跑：
#   python -m pptgen doctor --probe-llm
OPENAI_MODEL=deepseek-flash
DEFAULT_LOCALE=zh-CN

# 上游 .env 就是 true。改成 false 会让 prompt 分批形态与线上服务不同。
LLM_DISABLE_LOCAL_ONLY_BATCH_SPLIT=true

# RAG 必须关：本仓库的 requirements.txt 不装 qdrant / sentence-transformers，
# 打开会让 import 链去要它们。
RAG_ENABLED=false
RAG_ENABLE_RERANK=false

# 刻意不列在这里的键（见顶部那条约定）：
#   LLM_READ_TIMEOUT_SECONDS / LLM_CONNECT_TIMEOUT_SECONDS / LLM_RETRY_ATTEMPTS
# 由 pipeline.js --llm-read-timeout 等参数注入进程 env，本文件不写。
#
# 参考值：上游 report-generation/.env 用的是 LLM_READ_TIMEOUT_SECONDS=80，
# 而引擎自己的默认是 240。这里取更宽的引擎默认 —— 40 页要发多批请求，
# 单批读超时定得太短，会在长报告上偶发 APITimeoutError。
# 要压到上游口径：node pipeline.js generate ... --llm-read-timeout 80
